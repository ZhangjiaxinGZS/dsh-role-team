{
  "name": "dsh-role-team",
  "version": "0.1.0",
  "description": "Plain-text role and memory library for DeepSeek Harness teams",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0",
    "node": ">=24.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host.js"
    },
    "./client": "./dist/client.js",
    "./shared": {
      "types": "./dist/types/shared/index.d.ts",
      "default": "./dist/shared.js"
    },
    "./locale/en.json": "./locales/en-US.json",
    "./locale/zh.json": "./locales/zh-CN.json",
    "./locale/*.json": "./locales/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./remote": {
      "types": "./dist/types/shared/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./typert": {
      "types": "./dist/types/shared/remote.d.ts",
      "default": "./dist/remote.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "dist",
    "locales",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "pretest": "npm run build"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "yaml": "^2.8.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-team": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-permission-presets": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.5",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-reference": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-agent-team": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-schedule": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-subagent-control": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-loader": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.16.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhangjiaxinGZS/dsh-role-team.git"
  },
  "homepage": "https://github.com/ZhangjiaxinGZS/dsh-role-team#readme",
  "bugs": {
    "url": "https://github.com/ZhangjiaxinGZS/dsh-role-team/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "ai-team"
  ]
}
