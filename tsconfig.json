{
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "DOM",
      "ESNext.Decorators"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "benchmarks",
    "tsdown.config.ts"
  ]
}
